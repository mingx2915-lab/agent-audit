{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "知盾 AgentAudit desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/agent-audit-sidecar",
          "sidecar": true,
          "args": [
            "--host",
            "127.0.0.1",
            "--port",
            { "validator": "[0-9]{1,5}" },
            "--workspace",
            { "validator": ".+" },
            "--ready-file",
            { "validator": ".+" }
          ]
        }
      ]
    }
  ]
}
